            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/fifa/nat/Brazil",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fifa",
            "nat",
            "Brazil"
          ]
        }
      }
    }
  ]
}